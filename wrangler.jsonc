{
  "name": "contador-de-visitas",
  "main": "cloudflare-worker.js",
  "compatibility_date": "2026-03-20",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "contador-de-visitas.com/c/*",
      "zone_name": "contador-de-visitas.com"
    },
    {
      "pattern": "contador-de-visitas.com/api/*",
      "zone_name": "contador-de-visitas.com"
    },
    {
      "pattern": "contador-de-visitas.com/preview.svg*",
      "zone_name": "contador-de-visitas.com"
    },
    {
      "pattern": "contador-de-visitas.com/health*",
      "zone_name": "contador-de-visitas.com"
    },
    {
      "pattern": "contador-de-visitas.com/signup.php*",
      "zone_name": "contador-de-visitas.com"
    },
    {
      "pattern": "www.contador-de-visitas.com/c/*",
      "zone_name": "contador-de-visitas.com"
    },
    {
      "pattern": "www.contador-de-visitas.com/api/*",
      "zone_name": "contador-de-visitas.com"
    },
    {
      "pattern": "www.contador-de-visitas.com/preview.svg*",
      "zone_name": "contador-de-visitas.com"
    },
    {
      "pattern": "www.contador-de-visitas.com/health*",
      "zone_name": "contador-de-visitas.com"
    },
    {
      "pattern": "www.contador-de-visitas.com/signup.php*",
      "zone_name": "contador-de-visitas.com"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "COUNTERS",
        "class_name": "CounterDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "CounterDurableObject"
      ]
    }
  ]
}
